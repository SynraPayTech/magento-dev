<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <!-- Orders still awaiting SynraPay (the shopper left, or the frame said ok before SynraPay was final): read the order again. -->
        <job name="synra_pay_recheck" instance="Synra\Pay\Cron\Recheck" method="execute">
            <schedule>*/5 * * * *</schedule>
        </job>
    </group>
</config>

<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <payment>
            <synra_pay>
                <active>0</active>
                <model>SynraPayFacade</model>
                <title>Credit / Debit card</title>
                <description>Visa, Mastercard and American Express accepted. Secured by SynraPay.</description>
                <mode>develop</mode>
                <merchant_id/>
                <api_signature_key backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <fallback_phone>+971500000000</fallback_phone>
                <key_sha512 backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <x_api_key_name>x-synrapay-key</x_api_key_name>
                <x_api_key backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <live_base>https://api.synrapay.com/v1</live_base>
                <sandbox_base>https://sandbox-api.synrapay.com/v1</sandbox_base>
                <dev_base>https://dev-api.synrapay.com/v1</dev_base>
                <debug>0</debug>
                <order_status>pending_payment</order_status>
                <payment_action>initialize</payment_action>
                <can_initialize>1</can_initialize>
                <is_gateway>1</is_gateway>
                <can_use_checkout>1</can_use_checkout>
                <can_use_internal>0</can_use_internal>
                <can_order>1</can_order>
                <can_authorize>1</can_authorize>
                <can_capture>1</can_capture>
                <can_refund>1</can_refund>
                <can_refund_partial_per_invoice>1</can_refund_partial_per_invoice>
                <can_void>0</can_void>
                <allowspecific>0</allowspecific>
                <sort_order>1</sort_order>
                <group>synra_pay</group>
            </synra_pay>
        </payment>
    </default>
</config>

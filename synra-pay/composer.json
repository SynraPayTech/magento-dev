{
    "name": "synrapay/module-magento2",
    "description": "SynraPay payment method for Magento 2 / Adobe Commerce: SynraPay's own card fields (Direct API hosted session) on the checkout page.",
    "type": "magento2-module",
    "version": "1.0.0",
    "license": "proprietary",
    "require": {
        "php": ">=8.2.0",
        "magento/framework": ">=103.0.0",
        "magento/module-payment": "*",
        "magento/module-checkout": "*",
        "magento/module-sales": "*",
        "magento/module-quote": "*",
        "magento/module-config": "*",
        "magento/module-csp": "*"
    },
    "autoload": {
        "files": ["registration.php"],
        "psr-4": { "Synra\\Pay\\": "" }
    }
}
